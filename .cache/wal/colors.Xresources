! X colors.
! Generated by 'wal'
*foreground:        #c7c9d2
*background:        #21274d
*.foreground:       #c7c9d2
*.background:       #21274d
emacs*foreground:   #c7c9d2
emacs*background:   #21274d
URxvt*foreground:   #c7c9d2
XTerm*foreground:   #c7c9d2
UXTerm*foreground:  #c7c9d2
URxvt*background:   [100]#21274d
XTerm*background:   #21274d
UXTerm*background:  #21274d
URxvt*cursorColor:  #c7c9d2
XTerm*cursorColor:  #c7c9d2
UXTerm*cursorColor: #c7c9d2
URxvt*borderColor:  [100]#21274d

! Colors 0-15.
*.color0: #21274d
*color0:  #21274d
*.color1: #662B99
*color1:  #662B99
*.color2: #3B549F
*color2:  #3B549F
*.color3: #952EA9
*color3:  #952EA9
*.color4: #F9128F
*color4:  #F9128F
*.color5: #F616A2
*color5:  #F616A2
*.color6: #DD63AB
*color6:  #DD63AB
*.color7: #c7c9d2
*color7:  #c7c9d2
*.color8: #707388
*color8:  #707388
*.color9: #662B99
*color9:  #662B99
*.color10: #3B549F
*color10:  #3B549F
*.color11: #952EA9
*color11:  #952EA9
*.color12: #F9128F
*color12:  #F9128F
*.color13: #F616A2
*color13:  #F616A2
*.color14: #DD63AB
*color14:  #DD63AB
*.color15: #c7c9d2
*color15:  #c7c9d2

! Black color that will not be affected by bold highlighting.
*.color66: #21274d
*color66:  #21274d

! Xclock colors.
XClock*foreground: #c7c9d2
XClock*background: #21274d
XClock*majorColor:  rgba:c7/c9/d2/ff
XClock*minorColor:  rgba:c7/c9/d2/ff
XClock*hourColor:   rgba:c7/c9/d2/ff
XClock*minuteColor: rgba:c7/c9/d2/ff
XClock*secondColor: rgba:c7/c9/d2/ff

! Set depth to make transparency work.
URxvt*depth: 32
