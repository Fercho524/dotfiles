! X colors.
! Generated by 'wal'
*foreground:        #e2cfdd
*background:        #544561
*.foreground:       #e2cfdd
*.background:       #544561
emacs*foreground:   #e2cfdd
emacs*background:   #544561
URxvt*foreground:   #e2cfdd
XTerm*foreground:   #e2cfdd
UXTerm*foreground:  #e2cfdd
URxvt*background:   [100]#544561
XTerm*background:   #544561
UXTerm*background:  #544561
URxvt*cursorColor:  #e2cfdd
XTerm*cursorColor:  #e2cfdd
UXTerm*cursorColor: #e2cfdd
URxvt*borderColor:  [100]#544561

! Colors 0-15.
*.color0: #544561
*color0:  #544561
*.color1: #B0A5BA
*color1:  #B0A5BA
*.color2: #C3A6BE
*color2:  #C3A6BE
*.color3: #979EC1
*color3:  #979EC1
*.color4: #97A9C2
*color4:  #97A9C2
*.color5: #B1AEC5
*color5:  #B1AEC5
*.color6: #CBB1C8
*color6:  #CBB1C8
*.color7: #e2cfdd
*color7:  #e2cfdd
*.color8: #9e909a
*color8:  #9e909a
*.color9: #B0A5BA
*color9:  #B0A5BA
*.color10: #C3A6BE
*color10:  #C3A6BE
*.color11: #979EC1
*color11:  #979EC1
*.color12: #97A9C2
*color12:  #97A9C2
*.color13: #B1AEC5
*color13:  #B1AEC5
*.color14: #CBB1C8
*color14:  #CBB1C8
*.color15: #e2cfdd
*color15:  #e2cfdd

! Black color that will not be affected by bold highlighting.
*.color66: #544561
*color66:  #544561

! Xclock colors.
XClock*foreground: #e2cfdd
XClock*background: #544561
XClock*majorColor:  rgba:e2/cf/dd/ff
XClock*minorColor:  rgba:e2/cf/dd/ff
XClock*hourColor:   rgba:e2/cf/dd/ff
XClock*minuteColor: rgba:e2/cf/dd/ff
XClock*secondColor: rgba:e2/cf/dd/ff

! Set depth to make transparency work.
URxvt*depth: 32
