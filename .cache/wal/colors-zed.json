{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#21274d90",
                "editor.background": "#21274d90",
                "editor.foreground": "#c7c9d2",
                "text": "#c7c9d2",
                "text.muted": "#c7c9d270",
                "text.ignored": "#c7c9d240",
                "text.placeholder": "#c7c9d250",
                "ignored": "#c7c9d230",
                "element.hover": "#c7c9d230",
                "ghost_element.hover": "#662B9930",
                "ghost_element.selected": "#662B9930",
                "ghost_element.active": "#662B9960",
                "border": "#21274d",
                "editor.highlighted_line.background": "#662B9910",
                "editor.active_line.background": "#662B9910",
                "panel.background": "#21274d90",
                "title_bar.background": "#21274d90",
                "title_bar.inactive_background": "#21274d90",
                "status_bar.background": "#21274d90",
                "drop_target.background": "#21274d90",
                "elevated_surface.background": "#21274d",
                "toolbar.background": "#21274d90",
                "tab_bar.background": "#21274d90",
                "tab.inactive_background": "#21274d90",
                "tab.active_background": "#662B9930",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#21274d",
                "scrollbar.thumb.background": "#662B99",
                "editor.gutter.background": "#21274d90",
                "terminal.background": "#21274d10",
                "terminal.foreground": "#c7c9d2",
                "terminal.dim_foreground": "#c7c9d2",
                "terminal.bright_foreground": "#c7c9d2",
                "terminal.ansi.black": "#21274d",
                "terminal.ansi.red": "#662B99",
                "terminal.ansi.green": "#3B549F",
                "terminal.ansi.yellow": "#952EA9",
                "terminal.ansi.blue": "#F9128F",
                "terminal.ansi.magenta": "#F616A2",
                "terminal.ansi.cyan": "#DD63AB",
                "terminal.ansi.white": "#c7c9d2",
                "terminal.ansi.bright_black": "#707388",
                "terminal.ansi.bright_red": "#662B99",
                "terminal.ansi.bright_green": "#3B549F",
                "terminal.ansi.bright_yellow": "#952EA9",
                "terminal.ansi.bright_blue": "#F9128F",
                "terminal.ansi.bright_magenta": "#F616A2",
                "terminal.ansi.bright_cyan": "#DD63AB",
                "terminal.ansi.bright_white": "#c7c9d2",
                "modified": "#662B99",
                "syntax": {
                    "attribute": {
                        "color": "#662B99"
                    },
                    "boolean": {
                      "color": "#3B549F"
                    },
                    "comment": {
                      "color": "#707388"
                    },
                    "comment.doc": {
                      "color": "#707388"
                    },
                    "constant": {
                      "color": "#3B549F"
                    },
                    "function": {
                      "color": "#DD63AB"
                    },
                    "keyword": {
                      "color": "#F9128F"
                    },
                    "number": {
                      "color": "#F616A2"
                    },
                    "operator": {
                      "color": "#F9128F"
                    },
                    "string": {
                      "color": "#662B99"
                    },
                    "variable": {
                      "color": "#3B549F"
                    }
                },
                "players": [
                  {
                    "cursor": "#662B99",
                    "background": "#21274d",
                    "selection": "#662B9930"
                  }
                ]
            }
        }
    ]
}
