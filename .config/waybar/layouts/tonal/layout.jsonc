{
    "layer": "bottom",
    "position": "bottom",
    "height": 44,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-right": 0,
    "margin-left": 0,
    "include": [
        "~/.config/waybar/include.jsonc",
        "~/.config/waybar/include/include.jsonc",
        "~/.config/waybar/include/modules.jsonc"
    ],
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "custom/disk-toggle",
        "bluetooth",
        "custom/network"
    ],
    "modules-center": [
        "wlr/taskbar"
    ],
    "modules-right": [
        "pulseaudio",
        "custom/cpu",
        "memory",
        "custom/battery",
        "tray",
        "clock"
    ]
}
