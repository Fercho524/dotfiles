{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#0b0b1990",
                "editor.background": "#0b0b1990",
                "editor.foreground": "#c2c2c5",
                "text": "#c2c2c5",
                "text.muted": "#c2c2c570",
                "text.ignored": "#c2c2c540",
                "text.placeholder": "#c2c2c550",
                "ignored": "#c2c2c530",
                "element.hover": "#c2c2c530",
                "ghost_element.hover": "#144D7230",
                "ghost_element.selected": "#144D7230",
                "ghost_element.active": "#144D7260",
                "border": "#0b0b19",
                "editor.highlighted_line.background": "#144D7210",
                "editor.active_line.background": "#144D7210",
                "panel.background": "#0b0b1990",
                "title_bar.background": "#0b0b1990",
                "title_bar.inactive_background": "#0b0b1990",
                "status_bar.background": "#0b0b1990",
                "drop_target.background": "#0b0b1990",
                "elevated_surface.background": "#0b0b19",
                "toolbar.background": "#0b0b1990",
                "tab_bar.background": "#0b0b1990",
                "tab.inactive_background": "#0b0b1990",
                "tab.active_background": "#144D7230",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#0b0b19",
                "scrollbar.thumb.background": "#144D72",
                "editor.gutter.background": "#0b0b1990",
                "terminal.background": "#0b0b1910",
                "terminal.foreground": "#c2c2c5",
                "terminal.dim_foreground": "#c2c2c5",
                "terminal.bright_foreground": "#c2c2c5",
                "terminal.ansi.black": "#0b0b19",
                "terminal.ansi.red": "#144D72",
                "terminal.ansi.green": "#353A8E",
                "terminal.ansi.yellow": "#572D8B",
                "terminal.ansi.blue": "#2B5C92",
                "terminal.ansi.magenta": "#5B5FA3",
                "terminal.ansi.cyan": "#8B67B6",
                "terminal.ansi.white": "#c2c2c5",
                "terminal.ansi.bright_black": "#5a5a6e",
                "terminal.ansi.bright_red": "#144D72",
                "terminal.ansi.bright_green": "#353A8E",
                "terminal.ansi.bright_yellow": "#572D8B",
                "terminal.ansi.bright_blue": "#2B5C92",
                "terminal.ansi.bright_magenta": "#5B5FA3",
                "terminal.ansi.bright_cyan": "#8B67B6",
                "terminal.ansi.bright_white": "#c2c2c5",
                "modified": "#144D72",
                "syntax": {
                    "attribute": {
                        "color": "#144D72"
                    },
                    "boolean": {
                      "color": "#353A8E"
                    },
                    "comment": {
                      "color": "#5a5a6e"
                    },
                    "comment.doc": {
                      "color": "#5a5a6e"
                    },
                    "constant": {
                      "color": "#353A8E"
                    },
                    "function": {
                      "color": "#8B67B6"
                    },
                    "keyword": {
                      "color": "#2B5C92"
                    },
                    "number": {
                      "color": "#5B5FA3"
                    },
                    "operator": {
                      "color": "#2B5C92"
                    },
                    "string": {
                      "color": "#144D72"
                    },
                    "variable": {
                      "color": "#353A8E"
                    }
                },
                "players": [
                  {
                    "cursor": "#144D72",
                    "background": "#0b0b19",
                    "selection": "#144D7230"
                  }
                ]
            }
        }
    ]
}
