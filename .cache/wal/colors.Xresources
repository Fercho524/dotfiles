! X colors.
! Generated by 'wal'
*foreground:        #c2c2c5
*background:        #0b0b19
*.foreground:       #c2c2c5
*.background:       #0b0b19
emacs*foreground:   #c2c2c5
emacs*background:   #0b0b19
URxvt*foreground:   #c2c2c5
XTerm*foreground:   #c2c2c5
UXTerm*foreground:  #c2c2c5
URxvt*background:   [100]#0b0b19
XTerm*background:   #0b0b19
UXTerm*background:  #0b0b19
URxvt*cursorColor:  #c2c2c5
XTerm*cursorColor:  #c2c2c5
UXTerm*cursorColor: #c2c2c5
URxvt*borderColor:  [100]#0b0b19

! Colors 0-15.
*.color0: #0b0b19
*color0:  #0b0b19
*.color1: #6D6D70
*color1:  #6D6D70
*.color2: #B29967
*color2:  #B29967
*.color3: #7D7C82
*color3:  #7D7C82
*.color4: #8E8E91
*color4:  #8E8E91
*.color5: #9D9DA2
*color5:  #9D9DA2
*.color6: #ADADB0
*color6:  #ADADB0
*.color7: #c2c2c5
*color7:  #c2c2c5
*.color8: #5a5a6e
*color8:  #5a5a6e
*.color9: #6D6D70
*color9:  #6D6D70
*.color10: #B29967
*color10:  #B29967
*.color11: #7D7C82
*color11:  #7D7C82
*.color12: #8E8E91
*color12:  #8E8E91
*.color13: #9D9DA2
*color13:  #9D9DA2
*.color14: #ADADB0
*color14:  #ADADB0
*.color15: #c2c2c5
*color15:  #c2c2c5

! Black color that will not be affected by bold highlighting.
*.color66: #0b0b19
*color66:  #0b0b19

! Xclock colors.
XClock*foreground: #c2c2c5
XClock*background: #0b0b19
XClock*majorColor:  rgba:c2/c2/c5/ff
XClock*minorColor:  rgba:c2/c2/c5/ff
XClock*hourColor:   rgba:c2/c2/c5/ff
XClock*minuteColor: rgba:c2/c2/c5/ff
XClock*secondColor: rgba:c2/c2/c5/ff

! Set depth to make transparency work.
URxvt*depth: 32
