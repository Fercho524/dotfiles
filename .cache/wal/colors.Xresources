! X colors.
! Generated by 'wal'
*foreground:        #a5c2da
*background:        #0E1855
*.foreground:       #a5c2da
*.background:       #0E1855
emacs*foreground:   #a5c2da
emacs*background:   #0E1855
URxvt*foreground:   #a5c2da
XTerm*foreground:   #a5c2da
UXTerm*foreground:  #a5c2da
URxvt*background:   [100]#0E1855
XTerm*background:   #0E1855
UXTerm*background:  #0E1855
URxvt*cursorColor:  #a5c2da
XTerm*cursorColor:  #a5c2da
UXTerm*cursorColor: #a5c2da
URxvt*borderColor:  [100]#0E1855

! Colors 0-15.
*.color0: #0E1855
*color0:  #0E1855
*.color1: #662B99
*color1:  #662B99
*.color2: #3B549F
*color2:  #3B549F
*.color3: #952EA9
*color3:  #952EA9
*.color4: #F9128F
*color4:  #F9128F
*.color5: #F616A2
*color5:  #F616A2
*.color6: #DD63AB
*color6:  #DD63AB
*.color7: #a5c2da
*color7:  #a5c2da
*.color8: #738798
*color8:  #738798
*.color9: #662B99
*color9:  #662B99
*.color10: #3B549F
*color10:  #3B549F
*.color11: #952EA9
*color11:  #952EA9
*.color12: #F9128F
*color12:  #F9128F
*.color13: #F616A2
*color13:  #F616A2
*.color14: #DD63AB
*color14:  #DD63AB
*.color15: #a5c2da
*color15:  #a5c2da

! Black color that will not be affected by bold highlighting.
*.color66: #0E1855
*color66:  #0E1855

! Xclock colors.
XClock*foreground: #a5c2da
XClock*background: #0E1855
XClock*majorColor:  rgba:a5/c2/da/ff
XClock*minorColor:  rgba:a5/c2/da/ff
XClock*hourColor:   rgba:a5/c2/da/ff
XClock*minuteColor: rgba:a5/c2/da/ff
XClock*secondColor: rgba:a5/c2/da/ff

! Set depth to make transparency work.
URxvt*depth: 32
