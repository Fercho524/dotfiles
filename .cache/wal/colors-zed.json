{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#0b0b1990",
                "editor.background": "#0b0b1990",
                "editor.foreground": "#c2c2c5",
                "text": "#c2c2c5",
                "text.muted": "#c2c2c570",
                "text.ignored": "#c2c2c540",
                "text.placeholder": "#c2c2c550",
                "ignored": "#c2c2c530",
                "element.hover": "#c2c2c530",
                "ghost_element.hover": "#6D6D7030",
                "ghost_element.selected": "#6D6D7030",
                "ghost_element.active": "#6D6D7060",
                "border": "#0b0b19",
                "editor.highlighted_line.background": "#6D6D7010",
                "editor.active_line.background": "#6D6D7010",
                "panel.background": "#0b0b1990",
                "title_bar.background": "#0b0b1990",
                "title_bar.inactive_background": "#0b0b1990",
                "status_bar.background": "#0b0b1990",
                "drop_target.background": "#0b0b1990",
                "elevated_surface.background": "#0b0b19",
                "toolbar.background": "#0b0b1990",
                "tab_bar.background": "#0b0b1990",
                "tab.inactive_background": "#0b0b1990",
                "tab.active_background": "#6D6D7030",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#0b0b19",
                "scrollbar.thumb.background": "#6D6D70",
                "editor.gutter.background": "#0b0b1990",
                "terminal.background": "#0b0b1910",
                "terminal.foreground": "#c2c2c5",
                "terminal.dim_foreground": "#c2c2c5",
                "terminal.bright_foreground": "#c2c2c5",
                "terminal.ansi.black": "#0b0b19",
                "terminal.ansi.red": "#6D6D70",
                "terminal.ansi.green": "#B29967",
                "terminal.ansi.yellow": "#7D7C82",
                "terminal.ansi.blue": "#8E8E91",
                "terminal.ansi.magenta": "#9D9DA2",
                "terminal.ansi.cyan": "#ADADB0",
                "terminal.ansi.white": "#c2c2c5",
                "terminal.ansi.bright_black": "#5a5a6e",
                "terminal.ansi.bright_red": "#6D6D70",
                "terminal.ansi.bright_green": "#B29967",
                "terminal.ansi.bright_yellow": "#7D7C82",
                "terminal.ansi.bright_blue": "#8E8E91",
                "terminal.ansi.bright_magenta": "#9D9DA2",
                "terminal.ansi.bright_cyan": "#ADADB0",
                "terminal.ansi.bright_white": "#c2c2c5",
                "modified": "#6D6D70",
                "syntax": {
                    "attribute": {
                        "color": "#6D6D70"
                    },
                    "boolean": {
                      "color": "#B29967"
                    },
                    "comment": {
                      "color": "#5a5a6e"
                    },
                    "comment.doc": {
                      "color": "#5a5a6e"
                    },
                    "constant": {
                      "color": "#B29967"
                    },
                    "function": {
                      "color": "#ADADB0"
                    },
                    "keyword": {
                      "color": "#8E8E91"
                    },
                    "number": {
                      "color": "#9D9DA2"
                    },
                    "operator": {
                      "color": "#8E8E91"
                    },
                    "string": {
                      "color": "#6D6D70"
                    },
                    "variable": {
                      "color": "#B29967"
                    }
                },
                "players": [
                  {
                    "cursor": "#6D6D70",
                    "background": "#0b0b19",
                    "selection": "#6D6D7030"
                  }
                ]
            }
        }
    ]
}
