! X colors.
! Generated by 'wal'
*foreground:        #f4e9c9
*background:        #070118
*.foreground:       #f4e9c9
*.background:       #070118
emacs*foreground:   #f4e9c9
emacs*background:   #070118
URxvt*foreground:   #f4e9c9
XTerm*foreground:   #f4e9c9
UXTerm*foreground:  #f4e9c9
URxvt*background:   [100]#070118
XTerm*background:   #070118
UXTerm*background:  #070118
URxvt*cursorColor:  #f4e9c9
XTerm*cursorColor:  #f4e9c9
UXTerm*cursorColor: #f4e9c9
URxvt*borderColor:  [100]#070118

! Colors 0-15.
*.color0: #070118
*color0:  #070118
*.color1: #60045E
*color1:  #60045E
*.color2: #D94627
*color2:  #D94627
*.color3: #930356
*color3:  #930356
*.color4: #E2054D
*color4:  #E2054D
*.color5: #DE8157
*color5:  #DE8157
*.color6: #361594
*color6:  #361594
*.color7: #f4e9c9
*color7:  #f4e9c9
*.color8: #aaa38c
*color8:  #aaa38c
*.color9: #60045E
*color9:  #60045E
*.color10: #D94627
*color10:  #D94627
*.color11: #930356
*color11:  #930356
*.color12: #E2054D
*color12:  #E2054D
*.color13: #DE8157
*color13:  #DE8157
*.color14: #361594
*color14:  #361594
*.color15: #f4e9c9
*color15:  #f4e9c9

! Black color that will not be affected by bold highlighting.
*.color66: #070118
*color66:  #070118

! Xclock colors.
XClock*foreground: #f4e9c9
XClock*background: #070118
XClock*majorColor:  rgba:f4/e9/c9/ff
XClock*minorColor:  rgba:f4/e9/c9/ff
XClock*hourColor:   rgba:f4/e9/c9/ff
XClock*minuteColor: rgba:f4/e9/c9/ff
XClock*secondColor: rgba:f4/e9/c9/ff

! Set depth to make transparency work.
URxvt*depth: 32
